generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                         String                   @id @default(cuid())
  email                      String                   @unique
  username                   String                   @unique
  password                   String?
  role                       UserRole                 @default(USER)
  createdAt                  DateTime                 @default(now())
  updatedAt                  DateTime                 @updatedAt
  shareableId                String                   @unique @default(cuid())
  emailVerified              DateTime?
  showForceCurves            Boolean                  @default(true)
  emailNotifications         Boolean                  @default(true)
  emailMarketing             Boolean                  @default(true)
  accounts                   Account[]
  dismissedNotifications     DismissedNotification[]
  forceCurveFeedback         ForceCurveFeedback[]
  forceCurvePreferences      ForceCurvePreference[]
  forceCurveReviews          ForceCurveReviewCase[]   @relation("ForceCurveReviewResolver")
  forceCurveDecisions        ForceCurveMapping[]      @relation("ForceCurveMappingDecider")
  forceCurveMetadataVerified ForceCurveCatalogEntry[] @relation("ForceCurveMetadataVerifier")
  switchScoreFeedback        SwitchScoreFeedback[]
  manufacturers              Manufacturer[]
  approvedMasterSwitches     MasterSwitch[]           @relation("ApprovedBy")
  submittedMasterSwitches    MasterSwitch[]           @relation("SubmittedBy")
  approvedEdits              MasterSwitchEdit[]       @relation("ApprovedEditBy")
  masterSwitchEdits          MasterSwitchEdit[]       @relation("EditedBy")
  masterSwitchViews          MasterSwitchView[]
  notifications              Notification[]
  passwordResetTokens        PasswordResetToken[]
  switches                   Switch[]
  verificationTokens         VerificationToken[]
  wishlistItems              Wishlist[]
  partnerSubmissions         PartnerSubmission[]
  partnerCorrections         PartnerCorrection[]
}

model Switch {
  id                    String            @id @default(cuid())
  name                  String
  type                  SwitchType?
  springWeight          String?
  springLength          String?
  actuationForce        Float?
  bottomOutForce        Float?
  preTravel             Float?
  bottomOut             Float?
  manufacturer          String?
  notes                 String?
  imageUrl              String?
  topHousing            String?
  bottomHousing         String?
  stem                  String?
  dateObtained          DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  userId                String
  chineseName           String?
  compatibility         String?
  magnetOrientation     String?
  technology            SwitchTechnology?
  magnetPosition        String?
  initialForce          Float?
  initialMagneticFlux   Float?
  bottomOutMagneticFlux Float?
  pcbThickness          String?
  magnetPolarity        String?
  frankenBottom         String?
  frankenStem           String?
  frankenTop            String?
  isModified            Boolean           @default(false)
  masterSwitchId        String?
  masterSwitchVersion   Int?
  modifiedFields        Json?
  personalNotes         String?
  primaryImageId        String?
  doubleStage           Boolean           @default(false)
  progressiveSpring     Boolean           @default(false)
  tactileForce          Float?
  clickType             ClickType?
  tactilePosition       Float?
  personalTags          String[]          @default([])
  bottomHousingColor    String?
  markings              String?
  stemColor             String?
  stemShape             String?
  topHousingColor       String?
  shareableId           String?           @unique
  masterSwitch          MasterSwitch?     @relation(fields: [masterSwitchId], references: [id])
  user                  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  images                SwitchImage[]
}

model Manufacturer {
  id        String   @id @default(cuid())
  name      String   @unique
  aliases   String[]
  verified  Boolean  @default(false)
  addedBy   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User?    @relation(fields: [addedBy], references: [id])
}

model VerificationToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ForceCurvePreference {
  id             String   @id @default(cuid())
  userId         String
  switchName     String
  manufacturer   String?
  selectedFolder String
  selectedUrl    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, switchName, manufacturer])
}

model ForceCurveCache {
  id            String    @id @default(cuid())
  switchName    String
  manufacturer  String?
  hasForceCurve Boolean
  lastCheckedAt DateTime  @default(now())
  nextCheckAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([switchName, manufacturer])
}

model ForceCurveFeedback {
  id             String                  @id @default(cuid())
  userId         String
  switchName     String
  manufacturer   String?
  incorrectMatch String
  feedbackType   String
  suggestedMatch String?
  notes          String?
  createdAt      DateTime                @default(now())
  masterSwitchId String?
  catalogEntryId String?
  reviewCaseId   String?
  user           User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  masterSwitch   MasterSwitch?           @relation(fields: [masterSwitchId], references: [id], onDelete: SetNull)
  catalogEntry   ForceCurveCatalogEntry? @relation(fields: [catalogEntryId], references: [id], onDelete: SetNull)
  reviewCase     ForceCurveReviewCase?   @relation(fields: [reviewCaseId], references: [id], onDelete: SetNull)

  @@index([switchName, manufacturer])
}

model SwitchScoreFeedback {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  switchName     String
  manufacturer   String?
  incorrectMatch String
  feedbackType   String // 'incorrect_match' or 'no_score_exists'
  createdAt      DateTime @default(now())

  @@unique([switchName, manufacturer, incorrectMatch])
  @@index([userId])
  @@index([switchName, manufacturer])
}

model Account {
  id                String   @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model MasterSwitch {
  id                     String                  @id @default(cuid())
  name                   String
  chineseName            String?
  type                   SwitchType?
  technology             SwitchTechnology?
  magnetOrientation      String?
  magnetPosition         String?
  magnetPolarity         String?
  initialForce           Float?
  initialMagneticFlux    Float?
  bottomOutMagneticFlux  Float?
  pcbThickness           String?
  compatibility          String?
  springWeight           String?
  springLength           String?
  actuationForce         Float?
  bottomOutForce         Float?
  preTravel              Float?
  bottomOut              Float?
  manufacturer           String?
  notes                  String?
  imageUrl               String?
  topHousing             String?
  bottomHousing          String?
  stem                   String?
  frankenTop             String?
  frankenBottom          String?
  frankenStem            String?
  submittedById          String
  approvedById           String?
  approvedAt             DateTime?
  status                 MasterSwitchStatus      @default(PENDING)
  rejectionReason        String?
  version                Int                     @default(1)
  viewCount              Int                     @default(0)
  lastModifiedAt         DateTime                @default(now())
  originalSubmissionData Json?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  primaryImageId         String?
  doubleStage            Boolean                 @default(false)
  progressiveSpring      Boolean                 @default(false)
  tactileForce           Float?
  clickType              ClickType?
  tactilePosition        Float?
  shareableId            String?                 @unique
  bottomHousingColor     String?
  markings               String?
  stemColor              String?
  stemShape              String?
  topHousingColor        String?
  approvedBy             User?                   @relation("ApprovedBy", fields: [approvedById], references: [id])
  submittedBy            User                    @relation("SubmittedBy", fields: [submittedById], references: [id])
  edits                  MasterSwitchEdit[]
  views                  MasterSwitchView[]
  userSwitches           Switch[]
  images                 SwitchImage[]
  wishlistItems          Wishlist[]
  lifecycle              MasterSwitchLifecycle?
  partnerSubmissions     PartnerSubmission[]
  partnerCorrections     PartnerCorrection[]
  lifecycleMergeTargets  MasterSwitchLifecycle[] @relation("LifecycleMergedInto")
  forceCurveMappings     ForceCurveMapping[]
  forceCurveReviews      ForceCurveReviewCase[]
  forceCurveFeedback     ForceCurveFeedback[]

  @@index([name, manufacturer])
  @@index([status])
  @@index([submittedById])
  @@index([shareableId])
}

enum ForceCurveMappingState {
  AUTO_APPROVED
  REVIEW_REQUIRED
  MANUALLY_APPROVED
  REJECTED
  NO_MATCH
  STALE
}

enum ForceCurveReviewStatus {
  OPEN
  RESOLVED
}

enum ForceCurveSyncStatus {
  RUNNING
  COMPLETED
  FAILED
}

model ForceCurveCatalogEntry {
  id                   String                 @id @default(cuid())
  source               String
  repositoryPath       String
  displayName          String
  manufacturer         String?
  technology           SwitchTechnology?
  revision             String?
  contentHash          String?
  metadataVerifiedAt   DateTime?
  metadataVerifiedById String?
  exists               Boolean                @default(true)
  firstSeenAt          DateTime               @default(now())
  lastSeenAt           DateTime               @default(now())
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  mappings             ForceCurveMapping[]
  reviews              ForceCurveReviewCase[]
  feedback             ForceCurveFeedback[]
  metadataVerifiedBy   User?                  @relation("ForceCurveMetadataVerifier", fields: [metadataVerifiedById], references: [id], onDelete: SetNull)

  @@unique([source, repositoryPath])
  @@index([exists])
}

model ForceCurveMapping {
  id             String                  @id @default(cuid())
  masterSwitchId String
  catalogEntryId String?
  state          ForceCurveMappingState
  confidence     Float?
  provenance     String
  reason         String?
  decidedById    String?
  noMatchKey     String?                 @unique
  decidedAt      DateTime?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  masterSwitch   MasterSwitch            @relation(fields: [masterSwitchId], references: [id], onDelete: Cascade)
  catalogEntry   ForceCurveCatalogEntry? @relation(fields: [catalogEntryId], references: [id], onDelete: SetNull)
  decidedBy      User?                   @relation("ForceCurveMappingDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  @@unique([masterSwitchId, catalogEntryId])
  @@index([masterSwitchId, state])
}

model ForceCurveReviewCase {
  id             String                  @id @default(cuid())
  masterSwitchId String?
  catalogEntryId String?
  kind           String
  status         ForceCurveReviewStatus  @default(OPEN)
  reason         String
  payload        Json?
  resolution     ForceCurveMappingState?
  resolvedById   String?
  resolvedAt     DateTime?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  masterSwitch   MasterSwitch?           @relation(fields: [masterSwitchId], references: [id], onDelete: SetNull)
  catalogEntry   ForceCurveCatalogEntry? @relation(fields: [catalogEntryId], references: [id], onDelete: SetNull)
  resolvedBy     User?                   @relation("ForceCurveReviewResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  feedback       ForceCurveFeedback[]

  @@index([status, kind])
}

model ForceCurveSyncRun {
  id             String               @id @default(cuid())
  source         String
  revision       String
  status         ForceCurveSyncStatus @default(RUNNING)
  cursor         String?
  beforeCount    Int                  @default(0)
  afterCount     Int                  @default(0)
  newCount       Int                  @default(0)
  changedCount   Int                  @default(0)
  staleCount     Int                  @default(0)
  unmatchedCount Int                  @default(0)
  reviewCount    Int                  @default(0)
  errorCount     Int                  @default(0)
  errors         Json?
  startedAt      DateTime             @default(now())
  completedAt    DateTime?
  updatedAt      DateTime             @updatedAt

  @@unique([source, revision])
}

model MasterSwitchEdit {
  id                String             @id @default(cuid())
  masterSwitchId    String
  editedById        String
  previousData      Json
  newData           Json
  changedFields     Json
  editedAt          DateTime           @default(now())
  approvedById      String?
  status            MasterSwitchStatus @default(PENDING)
  rejectionReason   String?
  approvedBy        User?              @relation("ApprovedEditBy", fields: [approvedById], references: [id])
  editedBy          User               @relation("EditedBy", fields: [editedById], references: [id])
  masterSwitch      MasterSwitch       @relation(fields: [masterSwitchId], references: [id], onDelete: Cascade)
  partnerCorrection PartnerCorrection?

  @@index([masterSwitchId])
  @@index([editedById])
  @@index([status])
}

model MasterSwitchView {
  id             String       @id @default(cuid())
  masterSwitchId String
  userId         String
  viewedAt       DateTime     @default(now())
  masterSwitch   MasterSwitch @relation(fields: [masterSwitchId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([masterSwitchId])
  @@index([userId])
  @@index([viewedAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  link      String?
  linkText  String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([createdAt])
}

model DismissedNotification {
  id                      String   @id @default(cuid())
  userId                  String
  type                    String
  dismissedAt             DateTime @default(now())
  lastMasterUpdateVersion Int?
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
}

model SwitchImage {
  id                      String                   @id @default(cuid())
  switchId                String?
  masterSwitchId          String?
  url                     String
  type                    ImageType                @default(UPLOADED)
  order                   Int                      @default(0)
  caption                 String?
  width                   Int?
  height                  Int?
  size                    Int?
  uploadedAt              DateTime                 @default(now())
  altText                 String?
  remoteUrl               String?
  sourceUrl               String?
  sourceName              String?
  license                 String?
  attribution             String?
  checksumSha256          String?
  revision                Int                      @default(1)
  masterSwitch            MasterSwitch?            @relation(fields: [masterSwitchId], references: [id], onDelete: Cascade)
  switch                  Switch?                  @relation(fields: [switchId], references: [id], onDelete: SetNull)
  partnerSubmissionPhotos PartnerSubmissionPhoto[]

  @@index([switchId])
  @@index([masterSwitchId])
  @@index([masterSwitchId, remoteUrl])
  @@index([masterSwitchId, checksumSha256])
  @@index([order])
}

model PartnerApplication {
  id                    String                  @id @default(cuid())
  name                  String
  clientId              String                  @unique
  secretHash            String
  scopes                String[]
  redirectUris          String[]
  webhookUrl            String?
  webhookSecretEnvelope String?
  active                Boolean                 @default(true)
  rateLimitPerMinute    Int                     @default(120)
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  credentials           PartnerCredential[]
  auditEvents           PartnerAuditEvent[]
  idempotencyKeys       PartnerIdempotencyKey[]
  webhookEvents         PartnerWebhookEvent[]
  submissions           PartnerSubmission[]
  corrections           PartnerCorrection[]
}

model PartnerCredential {
  id            String             @id @default(cuid())
  applicationId String
  prefix        String             @unique
  secretHash    String
  scopes        String[]
  expiresAt     DateTime?
  revokedAt     DateTime?
  lastUsedAt    DateTime?
  createdAt     DateTime           @default(now())
  application   PartnerApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, revokedAt])
}

model MasterSwitchLifecycle {
  masterSwitchId    String              @id
  status            CatalogRecordStatus @default(ACTIVE)
  mergedIntoId      String?
  catalogApprovedAt DateTime
  removedAt         DateTime?
  removalReason     String?
  updatedAt         DateTime            @updatedAt
  masterSwitch      MasterSwitch        @relation(fields: [masterSwitchId], references: [id], onDelete: Cascade)
  mergedInto        MasterSwitch?       @relation("LifecycleMergedInto", fields: [mergedIntoId], references: [id], onDelete: Restrict)

  @@index([status])
  @@index([mergedIntoId])
}

model PartnerSubmission {
  id                String                   @id @default(cuid())
  applicationId     String
  userId            String
  masterSwitchId    String?
  status            PartnerSubmissionStatus  @default(SUBMITTED)
  payload           Json
  moderatorFeedback String?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  application       PartnerApplication       @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  user              User                     @relation(fields: [userId], references: [id], onDelete: Restrict)
  masterSwitch      MasterSwitch?            @relation(fields: [masterSwitchId], references: [id], onDelete: SetNull)
  photos            PartnerSubmissionPhoto[]

  @@index([applicationId, userId, updatedAt])
  @@index([masterSwitchId])
}

model PartnerSubmissionPhoto {
  id            String            @id @default(cuid())
  submissionId  String
  remoteUrl     String
  sourceUrl     String?
  status        String            @default("PENDING")
  error         String?
  switchImageId String?
  order         Int
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  submission    PartnerSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  switchImage   SwitchImage?      @relation(fields: [switchImageId], references: [id], onDelete: SetNull)

  @@unique([submissionId, remoteUrl])
  @@index([submissionId, order])
  @@index([status, updatedAt])
}

model PartnerCorrection {
  id                 String                  @id @default(cuid())
  applicationId      String
  userId             String
  masterSwitchId     String
  masterSwitchEditId String                  @unique
  status             PartnerSubmissionStatus @default(SUBMITTED)
  changes            Json
  reason             String
  moderatorFeedback  String?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  application        PartnerApplication      @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  user               User                    @relation(fields: [userId], references: [id], onDelete: Restrict)
  masterSwitch       MasterSwitch            @relation(fields: [masterSwitchId], references: [id], onDelete: Restrict)
  masterSwitchEdit   MasterSwitchEdit        @relation(fields: [masterSwitchEditId], references: [id], onDelete: Restrict)

  @@index([applicationId, userId, updatedAt])
  @@index([masterSwitchId])
}

model PartnerIdempotencyKey {
  id             String             @id @default(cuid())
  applicationId  String
  key            String
  requestHash    String
  responseStatus Int
  responseBody   Json
  expiresAt      DateTime
  createdAt      DateTime           @default(now())
  application    PartnerApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, key])
  @@index([expiresAt])
}

model PartnerAuditEvent {
  id            String              @id @default(cuid())
  applicationId String?
  actorUserId   String?
  requestId     String
  action        String
  resourceType  String?
  resourceId    String?
  statusCode    Int
  ipHash        String?
  metadata      Json?
  createdAt     DateTime            @default(now())
  application   PartnerApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  @@index([applicationId, createdAt])
  @@index([requestId])
}

model PartnerWebhookEvent {
  id            String                @id @default(cuid())
  applicationId String
  type          String
  payload       Json
  status        WebhookDeliveryStatus @default(PENDING)
  attempts      Int                   @default(0)
  nextAttemptAt DateTime              @default(now())
  deliveredAt   DateTime?
  lastError     String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  application   PartnerApplication    @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
}

model Wishlist {
  id                 String        @id @default(cuid())
  userId             String
  masterSwitchId     String?
  customName         String?
  customManufacturer String?
  customNotes        String?
  priority           Int           @default(0)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  masterSwitch       MasterSwitch? @relation(fields: [masterSwitchId], references: [id], onDelete: Cascade)
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, masterSwitchId])
  @@index([userId])
  @@index([masterSwitchId])
}

enum UserRole {
  USER
  ADMIN
}

enum SwitchType {
  LINEAR
  TACTILE
  CLICKY
  SILENT_LINEAR
  SILENT_TACTILE
  MOUSE
}

enum SwitchTechnology {
  MECHANICAL
  OPTICAL
  MAGNETIC
  INDUCTIVE
  ELECTRO_CAPACITIVE
}

enum MasterSwitchStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationType {
  SUBMISSION_APPROVED
  SUBMISSION_REJECTED
  EDIT_APPROVED
  EDIT_REJECTED
}

enum ImageType {
  UPLOADED
  LINKED
}

enum ClickType {
  CLICK_LEAF
  CLICK_BAR
  CLICK_JACKET
}

enum CatalogRecordStatus {
  ACTIVE
  MERGED
  REMOVED
}

enum PartnerSubmissionStatus {
  DRAFT
  SUBMITTED
  NEEDS_CHANGES
  APPROVED
  REJECTED
}

enum WebhookDeliveryStatus {
  PENDING
  DELIVERED
  FAILED
}

model Material {
  id        String   @id @default(cuid())
  name      String   @unique
  active    Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
  @@index([order])
}

model StemShape {
  id        String   @id @default(cuid())
  name      String   @unique
  active    Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
  @@index([order])
}
